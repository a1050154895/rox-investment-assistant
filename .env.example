ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:8008,http://127.0.0.1:8008
PORT=8008
# 下一阶段启用：
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/rox
# SESSION_SECRET=replace-with-a-long-random-secret
# 找回密码/邮箱验证邮件通道（SMTP，可选）。未配置时开发环境降级为日志投递。
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-smtp-password
# EMAIL_FROM=noreply@example.com
# 邮件里链接指向的应用地址；默认取 ALLOWED_ORIGINS 第一项
# APP_BASE_URL=http://localhost:8008
